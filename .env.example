# App
NEXT_PUBLIC_APP_URL=https://your-app-domain.up.railway.app
AUTH_SECRET=generate-a-long-random-string-here
AUTH_TRUST_HOST=true

# Admin seed (used by prisma/seed.ts — runs on every `npm start`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Admin

# Database
DATABASE_URL=postgresql://whatsapp:whatsapp@localhost:5432/whatsapp_bulk?schema=public

# Redis (campaign queue)
# Railway: reference the Redis service variable, e.g. ${{Redis.REDIS_URL}}
REDIS_URL=redis://localhost:6379

# SMTP relay (cPanel / iHosting — Railway sends mail here; relay delivers via local SMTP)
# On cPanel VPS: npm run smtp-relay  (or bash scripts/start-cpanel-smtp-relay.sh)
# On Railway: point to your public relay URL
SMTP_RELAY_URL=https://relay.devsynx.com
SMTP_RELAY_SECRET=generate-a-long-random-shared-secret

# cPanel relay server only:
SMTP_RELAY_PORT=8789
SMTP_RELAY_LOCAL_HOST=localhost

# Bounce handling (optional)
# Webhook secret for POST /api/webhooks/bounce (Authorization: Bearer <secret>)
BOUNCE_WEBHOOK_SECRET=generate-a-bounce-webhook-secret

# IMAP bounce mailbox poller (optional — used by npm run worker)
# Point at a mailbox that receives DSN/bounce notifications
# Bounce handling — read "Mail delivery failed" notices from your sending inbox
BOUNCE_IMAP_HOST=mail.devsynx.com
BOUNCE_IMAP_PORT=993
BOUNCE_IMAP_USER=info@devsynx.com
BOUNCE_IMAP_PASSWORD=your-mailbox-password
BOUNCE_IMAP_SECURE=true

# Lead scraper service (Gmap-scrapper)
# Railway: http://scraper.railway.internal:8787  (set PORT=8787 on the scraper service)
SCRAPER_URL=http://127.0.0.1:8787

# Meta WhatsApp Cloud API (fill when ready)
# You can also save these from Settings in the dashboard
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_WEBHOOK_VERIFY_TOKEN=whatsapp_bulk_verify_token
META_API_VERSION=v21.0
