{
  "name": "whatsapp-bulk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "prisma db push && prisma db seed && next start",
    "start:all": "bash scripts/start-all.sh",
    "lint": "eslint",
    "worker": "tsx scripts/worker.ts",
    "bounce:poll": "tsx -e \"import { pollBounceMailboxOnce } from './src/lib/email/bounce-poller.ts'; pollBounceMailboxOnce().then(n => console.log('Processed', n))\"",
    "scraper": "cd Gmap-scrapper && .venv/bin/python server.py",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "imapflow": "^1.7.2",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.28.0",
    "mailparser": "^3.9.15",
    "next": "16.2.12",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^8.0.11",
    "papaparse": "^5.5.4",
    "pino": "^10.3.1",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/papaparse": "^5.5.2",
    "@types/pino": "^7.0.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
