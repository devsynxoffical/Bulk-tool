generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  AGENT
}

enum Channel {
  WHATSAPP
  EMAIL
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

enum RecipientStatus {
  PENDING
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  SKIPPED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(AGENT)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  emailAccounts   EmailAccount[]
  sendingDomains  SendingDomain[]
  contacts        Contact[]
  leads           Lead[]
  templates       Template[]
  campaigns       Campaign[]
  suppressions    SuppressionList[]
  bounceEvents    BounceEvent[]
}

model EmailAccount {
  id            String         @id @default(cuid())
  ownerId       String
  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  provider      String         @default("SMTP")
  apiKey        String?
  host          String?
  port          Int?           @default(587)
  secure        Boolean?       @default(false)
  username      String?
  password      String?
  fromEmail     String
  fromName      String?
  signature     String?        @db.Text
  domainId      String?
  domain        SendingDomain? @relation(fields: [domainId], references: [id], onDelete: SetNull)
  dailyLimit    Int            @default(250)
  sentToday     Int            @default(0)
  lastSentAt    DateTime?
  healthScore   Int            @default(100)
  bounceCount   Int            @default(0)
  warmupEnabled Boolean        @default(true)
  warmupStage   Int            @default(1)
  /** Cap warmup progression (1–5). Null = use EngineConfig.warmupMaxStage. */
  warmupMaxStage Int?
  /** Override hourly send cap for this mailbox. Null = use EngineConfig. */
  hourlyCap     Int?
  /** Override min seconds between sends. Null = auto from hourly cap / engine. */
  sendIntervalSec Int?
  warmupStartedAt DateTime?
  isActive      Boolean        @default(true)
  /** Sends counted in the current hour window. */
  sentThisHour  Int            @default(0)
  hourWindowStart DateTime?
  /** When this mailbox was last paused (auto or manual). */
  pausedAt      DateTime?
  /** AUTO_BOUNCE | AUTH | MANUAL — only AUTO_BOUNCE/AUTH are auto-resumed. */
  pauseReason   String?
  lastInboxPollUid Int         @default(0)
  lastInboxSyncAt  DateTime?
  inboxSyncError   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  inboundEmails InboundEmail[]

  @@index([ownerId])
  @@index([domainId])
  @@index([isActive, sentToday])
  @@index([ownerId, isActive])
}

/** Singleton engine pacing / warmup defaults (id = "default"). */
model EngineConfig {
  id               String   @id @default("default")
  /** Highest warmup stage (1–5). Default 2 = 50/day. */
  warmupMaxStage   Int      @default(2)
  /** Max sends per mailbox per rolling hour. Default 6. */
  inboxHourlyCap   Int      @default(6)
  /** Optional global min seconds between sends on the same inbox. Null = auto. */
  inboxIntervalSec Int?
  updatedAt        DateTime @updatedAt
}

model InboundEmail {
  id                  String       @id @default(cuid())
  inboxId             String
  inbox               EmailAccount @relation(fields: [inboxId], references: [id], onDelete: Cascade)
  imapUid             Int
  messageId           String?
  fromEmail           String
  fromName            String?
  toEmail             String
  subject             String?
  bodyText            String?      @db.Text
  bodyHtml            String?      @db.Text
  isRead              Boolean      @default(false)
  isBounce            Boolean      @default(false)
  inReplyTo           String?
  relatedOutboundId   String?
  contactId           String?
  contact             Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  receivedAt          DateTime
  createdAt           DateTime     @default(now())

  @@unique([inboxId, imapUid])
  @@index([inboxId, receivedAt])
  @@index([inboxId, isRead])
  @@index([fromEmail])
  @@index([messageId])
}

model SendingDomain {
  id             String         @id @default(cuid())
  ownerId        String
  owner          User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  domainName     String         @unique
  dkimPrivateKey String?        @db.Text
  dkimPublicKey  String?        @db.Text
  dkimSelector   String         @default("dkim")
  spfRecordHint  String?        @db.Text
  spfVerified    Boolean        @default(false)
  dkimVerified   Boolean        @default(false)
  dmarcVerified  Boolean        @default(false)
  mxVerified     Boolean        @default(false)
  isVerified     Boolean        @default(false)
  dailyLimit     Int            @default(1000)
  sentToday      Int            @default(0)
  lastSentAt     DateTime?
  lastCheckedAt  DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  mailboxes      EmailAccount[]

  @@index([ownerId])
}

model SuppressionList {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  email     String
  reason    String   @default("UNSUBSCRIBED") // UNSUBSCRIBED | BOUNCED | COMPLAINT
  createdAt DateTime @default(now())

  @@unique([ownerId, email])
  @@index([ownerId])
}

model BounceEvent {
  id        String   @id @default(cuid())
  ownerId   String?
  owner     User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  email     String
  inboxId   String?
  contactId String?
  reason    String   @default("HARD_BOUNCE")
  raw       String?  @db.Text
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
  @@index([inboxId])
  @@index([ownerId])
}

model Contact {
  id            String               @id @default(cuid())
  ownerId       String
  owner         User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  phone         String?
  name          String?
  email         String?
  tags          String[]             @default([])
  optedOut      Boolean              @default(false)
  emailOptedOut Boolean              @default(false)
  customFields  Json?
  lastMessageAt DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  messages      Message[]
  recipients    CampaignRecipient[]
  conversations Conversation[]
  inboundEmails InboundEmail[]

  @@unique([ownerId, email])
  @@unique([ownerId, phone])
  @@index([ownerId])
}

model Lead {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  query     String
  name      String
  phone     String?
  email     String?
  website   String?
  address   String?
  category  String?
  rating    Float?
  reviews   Int?
  imported  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([query])
  @@index([createdAt])
}

model Template {
  id             String     @id @default(cuid())
  ownerId        String
  owner          User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  channel        Channel    @default(EMAIL)
  metaTemplateId String?
  name           String
  language       String     @default("en_US")
  category       String
  status         String
  subject        String?
  body           String?
  header         String?
  footer         String?
  pdfUrl         String?
  components     Json?
  isSample       Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  campaigns      Campaign[]

  @@unique([ownerId, name, language, channel])
  @@index([ownerId])
}

model Campaign {
  id                 String              @id @default(cuid())
  ownerId            String
  owner              User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name               String
  channel            Channel             @default(WHATSAPP)
  status             CampaignStatus      @default(DRAFT)
  templateId         String
  template           Template            @relation(fields: [templateId], references: [id])
  audienceFilter     Json?
  variableMapping    Json?
  scheduledAt        DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  rateLimitPerSecond Int                 @default(10)
  totalCount         Int                 @default(0)
  sentCount          Int                 @default(0)
  deliveredCount     Int                 @default(0)
  readCount          Int                 @default(0)
  failedCount        Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  recipients         CampaignRecipient[]
  messages           Message[]

  @@index([ownerId])
  @@index([ownerId, status])
}

model CampaignRecipient {
  id           String          @id @default(cuid())
  campaignId   String
  campaign     Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId    String
  contact      Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  status       RecipientStatus @default(PENDING)
  errorMessage String?
  messageId    String?
  /** Which mailbox sent this recipient (for open-rate health). */
  inboxId      String?
  sentAt       DateTime?
  deliveredAt  DateTime?
  readAt       DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([campaignId, contactId])
  @@index([campaignId, status])
  @@index([inboxId])
}

model Conversation {
  id                 String             @id @default(cuid())
  contactId          String
  contact            Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channel            Channel            @default(WHATSAPP)
  lastMessageAt      DateTime           @default(now())
  lastMessagePreview String?
  unreadCount        Int                @default(0)
  windowExpiresAt    DateTime?
  status             ConversationStatus @default(OPEN)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  messages           Message[]

  @@unique([contactId, channel])
  @@index([lastMessageAt])
}

model Message {
  id             String           @id @default(cuid())
  conversationId String?
  conversation   Conversation?    @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  contactId      String
  contact        Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  campaignId     String?
  campaign       Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  /** Sending mailbox used for this outbound email (open-rate health). */
  inboxId        String?
  channel        Channel          @default(WHATSAPP)
  direction      MessageDirection
  type           String           @default("text")
  subject        String?
  body           String?
  mediaUrl       String?
  templateName   String?
  metaMessageId  String?          @unique
  status         MessageStatus    @default(PENDING)
  errorCode      String?
  errorMessage   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([contactId, createdAt])
  @@index([metaMessageId])
  @@index([campaignId])
  @@index([inboxId])
}
